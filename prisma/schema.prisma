// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AppRole {
  USER
  ADMIN
}

enum SkillLevel {
  BEGINNER
  MIDDLE
  ADVANCED
}

enum ProjectStatus {
  RECRUITMENT
  IN_PROGRESS
  ENDED
}

enum ApplicationType {
  REQUEST
  INVITATION
}

enum ApplicationStatus {
  DECLINED
  ACCEPTED
  PENDING
}

enum CommunityRole {
  MEMBER
  MODERATOR
}

enum NotificationType {
  PROJECT_REQUEST
  PROJECT_INVITATION
  TEAM_REQUEST
  TEAM_INVITATION
  COMMENT
  PROJECT_DECLINED
  PROJECT_ACCEPTED
  TEAM_DECLINED
  TEAM_ACCEPTED
}

model User {
  id                  Int                  @id @default(autoincrement())
  email               String               @unique @db.VarChar(255)
  passwordHash        String               @db.VarChar(255)
  username            String               @unique @db.VarChar(50)
  name                String?              @db.VarChar(100)
  bio                 String?              @db.Text
  avatarUrl           String?              @db.VarChar(500)
  role                AppRole              @default(USER)
  createdAt           DateTime             @default(now())
  locationId          Int
  location            Location             @relation(fields: [locationId], references: [id])
  userSkills          UserSkill[]
  authoredProjects    Project[]
  projectMembers      ProjectMember[]
  projectApplications ProjectApplication[]
  ideas               Idea[]
  createdCommunities  Community[]
  communityMembers    CommunityMember[]
  posts               Post[]
  comments            Comment[]
  captainedTeams      Team[]
  teamMembers         TeamMember[]
  teamApplications    TeamApplication[]
  notifications       Notification[]
}

model Skill {
  id            Int            @id @default(autoincrement())
  name          String         @unique @db.VarChar(100)
  userSkills    UserSkill[]
  projectSkills ProjectSkill[]
  teamSkills    TeamSkill[]
}

model Role {
  id                  Int                  @id @default(autoincrement())
  name                String               @unique @db.VarChar(100)
  projectMembers      ProjectMember[]
  projectApplications ProjectApplication[]
}

model Location {
  id    Int    @id @default(autoincrement())
  name  String @unique @db.VarChar(100)
  users User[]
}

model UserSkill {
  userId     Int
  user       User       @relation(fields: [userId], references: [id])
  skillId    Int
  skill      Skill      @relation(fields: [skillId], references: [id])
  skillLevel SkillLevel @default(BEGINNER)

  @@id([userId, skillId])
}

model Project {
  id                  Int                  @id @default(autoincrement())
  name                String               @db.VarChar(100)
  description         String?              @db.Text
  status              ProjectStatus        @default(RECRUITMENT)
  authorId            Int
  author              User                 @relation(fields: [authorId], references: [id])
  createdAt           DateTime             @default(now())
  projectMembers      ProjectMember[]
  projectSkills       ProjectSkill[]
  projectApplications ProjectApplication[]
  idea                Idea?
}

model ProjectMember {
  userId       Int
  user         User    @relation(fields: [userId], references: [id])
  roleId       Int
  role         Role    @relation(fields: [roleId], references: [id])
  projectId    Int
  project      Project @relation(fields: [projectId], references: [id])
  contribution String? @db.Text

  @@id([userId, projectId])
}

model ProjectSkill {
  projectId  Int
  project    Project    @relation(fields: [projectId], references: [id])
  skillId    Int
  skill      Skill      @relation(fields: [skillId], references: [id])
  skillLevel SkillLevel @default(BEGINNER)

  @@id([projectId, skillId])
}

model ProjectApplication {
  id        Int               @id @default(autoincrement())
  userId    Int
  user      User              @relation(fields: [userId], references: [id])
  projectId Int
  project   Project           @relation(fields: [projectId], references: [id])
  roleId    Int
  role      Role              @relation(fields: [roleId], references: [id])
  type      ApplicationType   @default(REQUEST)
  message   String?           @db.Text
  status    ApplicationStatus @default(PENDING)
  createdAt DateTime          @default(now())
}

model Idea {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(100)
  authorId    Int
  author      User     @relation(fields: [authorId], references: [id])
  description String?  @db.Text
  projectId   Int?     @unique
  project     Project? @relation(fields: [projectId], references: [id])
  createdAt   DateTime @default(now())
}

model Community {
  id               Int               @id @default(autoincrement())
  name             String            @unique @db.VarChar(100)
  description      String?           @db.Text
  creatorId        Int
  creator          User              @relation(fields: [creatorId], references: [id])
  createdAt        DateTime          @default(now())
  communityMembers CommunityMember[]
  posts            Post[]
}

model CommunityMember {
  userId      Int
  user        User          @relation(fields: [userId], references: [id])
  role        CommunityRole @default(MEMBER)
  communityId Int
  community   Community     @relation(fields: [communityId], references: [id])

  @@id([userId, communityId])
}

model Post {
  id          Int       @id @default(autoincrement())
  authorId    Int
  author      User      @relation(fields: [authorId], references: [id])
  communityId Int
  community   Community @relation(fields: [communityId], references: [id])
  title       String?   @db.VarChar(255)
  imageUrl    String?   @db.VarChar(500)
  text        String    @db.Text
  createdAt   DateTime  @default(now())
  comments    Comment[]
}

model Comment {
  id        Int      @id @default(autoincrement())
  authorId  Int
  author    User     @relation(fields: [authorId], references: [id])
  postId    Int
  post      Post     @relation(fields: [postId], references: [id])
  text      String   @db.Text
  createdAt DateTime @default(now())
}

model Team {
  id               Int               @id @default(autoincrement())
  name             String            @db.VarChar(100)
  description      String?           @db.Text
  captainId        Int
  captain          User              @relation(fields: [captainId], references: [id])
  createdAt        DateTime          @default(now())
  teamMembers      TeamMember[]
  teamSkills       TeamSkill[]
  hackathonTeams   HackathonTeam[]
  teamApplications TeamApplication[]
}

model TeamMember {
  userId       Int
  user         User    @relation(fields: [userId], references: [id])
  teamId       Int
  team         Team    @relation(fields: [teamId], references: [id])
  contribution String? @db.Text

  @@id([userId, teamId])
}

model TeamSkill {
  teamId     Int
  team       Team       @relation(fields: [teamId], references: [id])
  skillId    Int
  skill      Skill      @relation(fields: [skillId], references: [id])
  skillLevel SkillLevel @default(BEGINNER)

  @@id([teamId, skillId])
}

model Hackathon {
  id             Int             @id @default(autoincrement())
  name           String          @db.VarChar(255)
  description    String?         @db.Text
  startDate      DateTime
  endDate        DateTime
  location       String?         @db.VarChar(255)
  organizerUrl   String?         @db.VarChar(500)
  hackathonTeams HackathonTeam[]
}

model HackathonTeam {
  teamId      Int
  team        Team      @relation(fields: [teamId], references: [id])
  hackathonId Int
  hackathon   Hackathon @relation(fields: [hackathonId], references: [id])

  @@id([teamId, hackathonId])
}

model TeamApplication {
  id        Int               @id @default(autoincrement())
  userId    Int
  user      User              @relation(fields: [userId], references: [id])
  teamId    Int
  team      Team              @relation(fields: [teamId], references: [id])
  type      ApplicationType   @default(REQUEST)
  message   String?           @db.Text
  status    ApplicationStatus @default(PENDING)
  createdAt DateTime          @default(now())
}

model Notification {
  id          Int              @id @default(autoincrement())
  recipientId Int
  recipient   User             @relation(fields: [recipientId], references: [id])
  /// id объекта, к которому ведёт уведомление.
  /// Таблица зависит от type:
  /// PROJECT_* → projectApplications
  /// TEAM_* → teamApplications
  /// COMMENT → comments
  entityId    Int
  type        NotificationType
  text        String?          @db.Text
  isRead      Boolean          @default(false)
  createdAt   DateTime         @default(now())
}
